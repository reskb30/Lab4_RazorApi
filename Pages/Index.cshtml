@page
@model IndexModel
@{
    ViewData["Title"] = "Студенти API";
}

<div class="container mt-4">
    <h2 class="mb-4">Управління студентами (Razor Pages + Web API)</h2>

    <div class="card p-4 mb-4 shadow-sm">
        <h4 id="formTitle" class="mb-3">Додати студента</h4>
        <form id="studentForm">
            <input type="hidden" id="studentId" value="0" />
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">ПІБ:</label>
                    <input type="text" id="fullName" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Адреса:</label>
                    <input type="text" id="address" class="form-control" required />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Телефон:</label>
                    <input type="text" id="phone" class="form-control" required />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Дата народження:</label>
                    <input type="date" id="birthDate" class="form-control" required />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Стипендія:</label>
                    <input type="number" step="0.01" id="scholarship" class="form-control" required />
                </div>
            </div>
            <button type="submit" class="btn btn-success">Зберегти</button>
            <button type="button" class="btn btn-secondary ms-2" onclick="resetForm()">Очистити</button>
        </form>
    </div>

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ПІБ</th>
                <th>Адреса</th>
                <th>Телефон</th>
                <th>Дата народження</th>
                <th>Стипендія</th>
                <th>Дії</th>
            </tr>
        </thead>
        <tbody id="studentsTableBody">
            <!-- Дані будуть завантажені через Web API -->
        </tbody>
    </table>
</div>

<script>
    const apiUrl = '/api/students';

    document.addEventListener('DOMContentLoaded', loadStudents);

    document.getElementById('studentForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const id = document.getElementById('studentId').value;
        const student = {
            studentId: parseInt(id),
            fullName: document.getElementById('fullName').value,
            address: document.getElementById('address').value,
            phone: document.getElementById('phone').value,
            birthDate: document.getElementById('birthDate').value,
            scholarshipAmount: parseFloat(document.getElementById('scholarship').value)
        };

        if (student.studentId === 0) {
            await fetch(apiUrl, { 
                method: 'POST', 
                headers: { 'Content-Type': 'application/json' }, 
                body: JSON.stringify(student) 
            });
        } else {
            await fetch(`${apiUrl}/${student.studentId}`, { 
                method: 'PUT', 
                headers: { 'Content-Type': 'application/json' }, 
                body: JSON.stringify(student) 
            });
        }
        
        resetForm();
        loadStudents();
    });

    async function loadStudents() {
        const response = await fetch(apiUrl);
        const students = await response.json();
        const tbody = document.getElementById('studentsTableBody');
        tbody.innerHTML = '';
        
        students.forEach(s => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>${s.fullName}</td>
                <td>${s.address}</td>
                <td>${s.phone}</td>
                <td>${s.birthDate.split('T')[0]}</td>
                <td>${s.scholarshipAmount}</td>
                <td>
                    <button class="btn btn-sm btn-warning" onclick='editStudent(${JSON.stringify(s).replace(/'/g, "&#39;")})'>Редагувати</button>
                    <button class="btn btn-sm btn-danger" onclick='deleteStudent(${s.studentId})'>Видалити</button>
                </td>
            `;
            tbody.appendChild(tr);
        });
    }

    function editStudent(s) {
        document.getElementById('formTitle').innerText = 'Редагувати студента';
        document.getElementById('studentId').value = s.studentId;
        document.getElementById('fullName').value = s.fullName;
        document.getElementById('address').value = s.address;
        document.getElementById('phone').value = s.phone;
        document.getElementById('birthDate').value = s.birthDate.split('T')[0];
        document.getElementById('scholarship').value = s.scholarshipAmount;
        window.scrollTo(0, 0);
    }

    async function deleteStudent(id) {
        if (confirm('Ви впевнені, що хочете видалити цього студента?')) {
            await fetch(`${apiUrl}/${id}`, { method: 'DELETE' });
            loadStudents();
        }
    }

    function resetForm() {
        document.getElementById('formTitle').innerText = 'Додати студента';
        document.getElementById('studentId').value = '0';
        document.getElementById('studentForm').reset();
    }
</script>